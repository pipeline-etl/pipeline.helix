{
    "name": "pipeline-etl/requests-source",
    "description": "Pipeline.RequestsSource is an HTTP/HTTPS pipeline source for retrieving data from HTTP endpoints",
    "keywords": [
        "pipeline-etl",
        "data import",
        "ETL",
        "HTTP",
        "source"
    ],
    "homepage": "https://github.com/pipeline-etl/pipeline.requests-source",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": ">=10.5 <11.0",
        "ext-xdebug": "~3.1"
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "Pipeline\\": "src/Pipeline/"
        }
    }
}
